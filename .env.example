# Application
NODE_ENV=development
PORT=3000
API_VERSION=v1

# MySQL Docker Configuration
MYSQL_ROOT_PASSWORD=rootpassword123
MYSQL_DATABASE=restaurant_api
MYSQL_USER=restaurant_user
MYSQL_PASSWORD=restaurant_pass123

# Database Connection (for your app)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=restaurant_api
DB_USER=restaurant_user
DB_PASSWORD=restaurant_pass123
DB_DIALECT=mysql
DB_POOL_MAX=5
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# JWT
JWT_ACCESS_SECRET=your_super_secret_access_key_min_32_characters_here
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_characters_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Security
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=15

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# CORS
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info